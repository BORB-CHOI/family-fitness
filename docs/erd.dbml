// 우리가족 체력키움 (family-fitness) — ERD
// dbdiagram.io 에 그대로 붙여넣으세요
// ADR-001에 따른 목표 ERD (단일 PostgreSQL + pgvector / Spring Boot + Python AI 서비스 구조)

// ===== identity — 계정 · 가족 · 구성원 =====
Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: "사용자 ID"]
  provider varchar(20) [not null, default: `'GOOGLE'`, note: "OAuth 제공자 (GOOGLE 단일 로그인)"]
  provider_user_id varchar(191) [not null, note: "구글 고유 계정 식별자 (sub 값)"]
  email varchar(255) [note: "구글 이메일 주소"]
  status varchar(20) [not null, default: `'ACTIVE'::character varying`, note: "계정 상태 (ACTIVE, INACTIVE 등)"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]
  updated_at timestamptz [not null, default: `now()`, note: "수정 일시"]
  
  indexes { (provider,provider_user_id) [unique, name: 'uq_users_provider'] }
  Note: "구글 OAuth 전용 계정 정보 (비밀번호 저장 안 함)"
}

Table families {
  id uuid [pk, default: `gen_random_uuid()`, note: "가족 ID"]
  name varchar(60) [not null, note: "가족 그룹 이름"]
  region_code varchar(20) [note: "지역 코드"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]
  updated_at timestamptz [not null, default: `now()`, note: "수정 일시"]

  Note: "가족 그룹 정보"
}

Table profiles {
  id uuid [pk, default: `gen_random_uuid()`, note: "프로필 ID"]
  family_id uuid [not null, note: "소속 가족 ID"]
  user_id uuid [note: "연결된 사용자 계정 ID (미연결 가능)"]
  display_name varchar(30) [not null, note: "표시 이름 (별명/이름)"]
  birth_date date [not null, note: "생년월일"]
  sex varchar(6) [not null, note: "성별 (MALE, FEMALE)"]
  role varchar(10) [not null, note: "가족 내 역할 (PARENT, CHILD 등)"]
  is_owner boolean [not null, default: `false`, note: "가족 대표/소유자 여부"]
  height_cm numeric(4,1) [note: "키 (cm)"]
  weight_kg numeric(4,1) [note: "몸무게 (kg)"]
  support_mode varchar(20) [note: "돌봄/지원 모드 구분"]
  claim_code varchar(8) [note: "프로필 연동/점유용 초대 코드"]
  claim_code_expires_at timestamptz [note: "초대 코드 만료 일시"]
  consent_personal_at timestamptz [note: "개인정보 동의 일시"]
  consent_health_at timestamptz [note: "건강정보 동의 일시"]
  consent_by_user_id uuid [note: "동의를 진행한 계정 ID"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]
  updated_at timestamptz [not null, default: `now()`, note: "수정 일시"]

  Note: "가족 구성원 프로필 (계정 없는 어린이/어르신 포함)"
}

Table cheers {
  id uuid [pk, default: `gen_random_uuid()`, note: "응원 ID"]
  family_id uuid [not null, note: "가족 ID"]
  from_profile_id uuid [not null, note: "보낸 사람 프로필 ID"]
  to_profile_id uuid [not null, note: "받는 사람 프로필 ID"]
  sticker_code varchar(20) [note: "응원 스티커 코드"]
  message varchar(200) [note: "응원 메시지 내용"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  Note: "가족 구성원 간 응원/스티커 및 메시지"
}

// ===== fitness — 규준 · 측정 · 예측 =====
Table fitness_norms {
  id bigint [pk, default: `nextval('fitness_norms_id_seq'::regclass)`, note: "규준 데이터 ID"]
  item varchar(30) [not null, note: "체력 측정 항목 (예: 악력, 유연성 등)"]
  sex varchar(6) [not null, note: "성별"]
  age_from smallint [not null, note: "적용 시작 연령"]
  age_to smallint [not null, note: "적용 종료 연령"]
  percentile smallint [not null, note: "백분위수"]
  value numeric(8,3) [not null, note: "규준 기준값"]
  source_year smallint [not null, note: "출처 수집 연도"]

  indexes { (item,sex,age_from,age_to,percentile,source_year) [unique, name: 'uq_fitness_norm'] }
  Note: "연령/성별별 국가 체력 측정 규준 데이터"
}

Table fitness_tests {
  id uuid [pk, default: `gen_random_uuid()`, note: "체력 측정 기록 ID"]
  profile_id uuid [not null, note: "대상 프로필 ID"]
  measured_on date [not null, note: "측정 날짜"]
  source varchar(20) [not null, note: "측정 출처 (인바디, 센터, 자가 등)"]
  age_at_test smallint [not null, note: "측정 당시 연령"]
  height_cm numeric(4,1) [note: "측정 당시 키"]
  weight_kg numeric(4,1) [note: "측정 당시 몸무게"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  indexes { (profile_id,measured_on) [unique, name: 'uq_fitness_test'] }
  Note: "체력 측정 수행 이력 헤더"
}

Table fitness_test_items {
  fitness_test_id uuid [not null, note: "체력 측정 기록 ID"]
  item varchar(30) [not null, note: "측정 항목 (예: 악력, 윗몸일으키기)"]
  raw_value numeric(8,3) [not null, note: "실제 측정 원시값"]
  percentile numeric(5,2) [note: "계산된 백분위"]
  grade varchar(10) [note: "계산된 체력 등급 (1등급, 2등급 등)"]

  indexes { (fitness_test_id,item) [pk, name: 'pk_fitness_test_items'] }
  Note: "체력 측정 세부 항목별 결과"
}

Table predictions {
  id uuid [pk, default: `gen_random_uuid()`, note: "예측 기록 ID"]
  profile_id uuid [not null, note: "대상 프로필 ID"]
  fitness_test_id uuid [note: "기반이 된 체력 측정 ID"]
  model_version varchar(40) [not null, note: "사용된 AI 예측 모델 버전"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  Note: "미래 체력 변화 예측 모델 실행 헤더"
}

Table prediction_points {
  prediction_id uuid [not null, note: "예측 기록 ID"]
  scenario varchar(20) [not null, note: "시나리오 (MAINTAIN, IMPROVE 등)"]
  item varchar(30) [not null, note: "측정 항목"]
  years_from_now smallint [not null, note: "몇 년 후 예측인지 (N년 후)"]
  p10 numeric(8,3) [note: "하위 10% 예측값"]
  p50 numeric(8,3) [note: "중앙값(50%) 예측값"]
  p90 numeric(8,3) [note: "상위 10% 예측값"]

  indexes { (prediction_id,scenario,item,years_from_now) [pk, name: 'pk_prediction_points'] }
  Note: "시나리오 및 연도별 미래 체력 예측 포인트"
}

// ===== activity — 활동 기록 =====
Table activity_daily {
  id uuid [pk, default: `gen_random_uuid()`, note: "일별 활동 ID"]
  profile_id uuid [not null, note: "대상 프로필 ID"]
  activity_date date [not null, note: "활동 날짜"]
  source varchar(10) [not null, note: "데이터 출처 (MANUAL, WATCH 등)"]
  steps int [not null, default: `0`, note: "걸음 수"]
  active_minutes smallint [not null, default: `0`, note: "활동 시간 (분)"]
  recorded_at timestamptz [not null, default: `now()`, note: "기록 일시"]

  indexes { (profile_id,activity_date,source) [unique, name: 'uq_activity_daily'] }
  Note: "일별 일상 활동 데이터 (걸음 수, 운동 시간)"
}

// ===== coaching — 영상 · 코치 · 미션 (Spring Boot 소유) =====
Table exercise_videos {
  id uuid [pk, default: `gen_random_uuid()`, note: "운동 영상 ID"]
  youtube_id varchar(32) [not null, note: "유튜브 비디오 고유 ID"]
  title varchar(300) [not null, note: "영상 제목"]
  channel_name varchar(120) [not null, note: "유튜브 채널명"]
  channel_type varchar(20) [not null, note: "채널 유형 (공공, 전문가 등)"]
  duration_sec smallint [note: "영상 재생 시간 (초)"]
  age_from smallint [not null, note: "권장 시작 연령"]
  age_to smallint [not null, note: "권장 종료 연령"]
  target_item varchar(30) [note: "타겟 체력 항목 (예: 악력, 유연성)"]
  intensity varchar(10) [not null, note: "운동 강도 (LOW, MID, HIGH)"]
  space varchar(20) [not null, note: "장소 조건 (INDOOR, OUTDOOR)"]
  noise varchar(10) [not null, note: "층간소음 수준 (NONE, LOW 등)"]
  equipment varchar(60) [note: "필요 운동 기구"]
  labeled_by varchar(20) [not null, note: "라벨링 주체 (AI, HUMAN)"]
  label_model varchar(40) [note: "라벨링에 사용된 AI 모델"]
  collected_at timestamptz [not null, default: `now()`, note: "수집 일시"]

  Note: "추천용 운동 콘텐츠 및 라벨링 메타데이터 (Spring Boot 소유)"
}

Table video_interactions {
  id uuid [pk, default: `gen_random_uuid()`, note: "상호작용 ID"]
  profile_id uuid [not null, note: "대상 프로필 ID"]
  video_id uuid [not null, note: "운동 영상 ID"]
  kind varchar(10) [not null, note: "상호작용 유형 (LIKE, WATCH, COMPLETED)"]
  progress smallint [not null, default: `0`, note: "시청 진도율 (%)"]
  occurred_at timestamptz [not null, default: `now()`, note: "발생 일시"]

  indexes { (profile_id,video_id,kind) [unique, name: 'uq_video_interaction'] }
  Note: "사용자의 운동 영상 시청/좋아요 이력"
}

// ===== ai_index — Python AI 서비스가 생성·검색하는 pgvector 인덱스 =====
Table ai_documents {
  id uuid [pk, default: `gen_random_uuid()`, note: "AI 문서 ID"]
  content text [not null, note: "임베딩 대상 원문 텍스트"]
  document_kind varchar(30) [not null, note: "문서 유형 (GUIDE, VIDEO_CAPTION 등)"]
  video_id uuid [note: "연관된 운동 영상 ID (선택)"]
  fitness_item varchar(30) [note: "연관된 체력 항목 (선택)"]
  age_from smallint [note: "대상 연령대 하한"]
  source_label varchar(200) [not null, note: "출처 표시 라벨"]
  source_uri varchar(500) [note: "출처 URI/링크"]
  content_hash char(64) [not null, note: "중복 방지 및 갱신 감지용 SHA-256 해시"]
  embedding vector(1536) [not null, note: "RAG 검색용 임베딩 벡터"]
  embedding_model varchar(80) [not null, note: "사용한 임베딩 모델명 (text-embedding-3-small 등)"]
  embedding_version varchar(40) [not null, note: "임베딩 버전"]
  embedded_at timestamptz [not null, default: `now()`, note: "임베딩 생성 일시"]

  indexes { (content_hash,embedding_version) [unique, name: 'uq_ai_documents_content_embedding'] }
  Note: "Python AI 서비스 전용 RAG 임베딩 및 지식베이스 (pgvector)"
}

Table coach_runs {
  id uuid [pk, default: `gen_random_uuid()`, note: "코치 실행 ID"]
  family_id uuid [not null, note: "대상 가족 ID"]
  week_start date [not null, note: "해당 주차 시작일"]
  trigger_type varchar(10) [not null, note: "실행 트리거 (CRON, MANUAL)"]
  status varchar(20) [not null, default: `'RUNNING'::character varying`, note: "진행 상태 (RUNNING, APPROVED, REJECTED)"]
  summary text [note: "AI가 생성한 가족 건강 리포트 요약"]
  approved_by uuid [note: "제안을 승인한 대표 프로필 ID"]
  approved_at timestamptz [note: "승인 일시"]
  rejected_reason varchar(300) [note: "거절 시 사유"]
  model_name varchar(40) [note: "생성에 사용된 AI 모델"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  indexes { (family_id,week_start) [unique, name: 'uq_coach_run'] }
  Note: "주차별 AI 코칭 생성 및 승인 이력 (Spring Boot 쓰기)"
}

Table coach_run_proposal_items {
  coach_run_id uuid [not null, note: "코치 실행 ID"]
  position smallint [not null, note: "제안 항목 순서"]
  title varchar(120) [not null, note: "미션 제안 제목"]
  description varchar(400) [note: "미션 설명"]
  target_metric varchar(20) [not null, note: "목표 지표 (STEPS, TIME 등)"]
  target_value int [not null, note: "목표치"]
  video_id uuid [note: "추천 운동 영상 ID"]
  rationale varchar(400) [note: "AI 추천 사유"]
  starts_on date [not null, note: "미션 권장 시작일"]
  ends_on date [not null, note: "미션 권장 종료일"]

  indexes { (coach_run_id,position) [pk, name: 'pk_coach_run_proposal_items'] }
  Note: "AI가 제안한 주차별 추천 미션 세부 목록"
}

Table missions {
  id uuid [pk, default: `gen_random_uuid()`, note: "미션 ID"]
  family_id uuid [not null, note: "가족 ID"]
  coach_run_id uuid [note: "기반이 된 AI 코치 실행 ID (선택)"]
  title varchar(120) [not null, note: "미션 제목"]
  description varchar(400) [note: "미션 설명"]
  origin varchar(10) [not null, note: "미션 생성 출처 (AI, MANUAL)"]
  target_metric varchar(20) [not null, note: "목표 지표 (STEPS, TIME 등)"]
  target_value int [not null, note: "목표치"]
  video_id uuid [note: "연관된 운동 영상 ID"]
  rationale varchar(400) [note: "추천/설정 사유"]
  starts_on date [not null, note: "미션 시작일"]
  ends_on date [not null, note: "미션 종료일"]
  created_by uuid [note: "미션 생성자 프로필 ID"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  Note: "가족이 최종 확정하여 수행 중인 운동/활동 미션 (Spring Boot 쓰기)"
}

Table mission_participants {
  mission_id uuid [not null, note: "미션 ID"]
  profile_id uuid [not null, note: "참여 프로필 ID"]
  status varchar(20) [not null, default: `'PENDING'`, note: "수행 상태 (PENDING, COMPLETED 등)"]
  progress smallint [not null, default: 0, note: "달성률 (%)"]
  verified_by varchar(20) [note: "인증 방식 (AUTO, PARENT 등)"]
  verified_at timestamptz [note: "인증 완료 일시"]
  confirmed_by_profile_id uuid [note: "수동 인증을 확인해 준 보호자 프로필 ID"]

  indexes { (mission_id,profile_id) [pk, name: 'pk_mission_participants'] }
  Note: "구성원별 미션 참여 status 및 진행도"
}

Table coach_messages {
  id uuid [pk, default: `gen_random_uuid()`, note: "메시지 ID"]
  conversation_id uuid [not null, note: "대화 세션/방 ID"]
  profile_id uuid [not null, note: "대화 참여 프로필 ID"]
  role varchar(10) [not null, note: "발화 주체 (USER, ASSISTANT)"]
  content text [not null, note: "대화 내용"]
  created_at timestamptz [not null, default: `now()`, note: "생성 일시"]

  Note: "AI 건강 코치와의 대화 메시지 기록 (Spring Boot 쓰기)"
}

Table coach_message_citations {
  coach_message_id uuid [not null, note: "코치 메시지 ID"]
  position smallint [not null, note: "인용 출처 순서"]
  ai_document_id uuid [note: "참조한 AI 문서 ID"]
  source_label varchar(200) [not null, note: "출처 표시 라벨"]
  excerpt varchar(500) [note: "인용 발췌문"]

  indexes { (coach_message_id,position) [pk, name: 'pk_coach_message_citations'] }
  Note: "AI 답변 생성 시 사용된 RAG (ai_documents) 인용 근거 정보"
}

// ===== References (관계 정의) =====
Ref: activity_daily.profile_id > profiles.id
Ref: cheers.family_id > families.id
Ref: cheers.from_profile_id > profiles.id
Ref: cheers.to_profile_id > profiles.id
Ref: coach_messages.profile_id > profiles.id
Ref: coach_runs.family_id > families.id
Ref: coach_runs.approved_by > profiles.id
Ref: fitness_tests.profile_id > profiles.id
Ref: fitness_test_items.fitness_test_id > fitness_tests.id
Ref: missions.family_id > families.id
Ref: missions.coach_run_id > coach_runs.id
Ref: missions.video_id > exercise_videos.id
Ref: missions.created_by > profiles.id
Ref: predictions.profile_id > profiles.id
Ref: predictions.fitness_test_id > fitness_tests.id
Ref: prediction_points.prediction_id > predictions.id
Ref: profiles.family_id > families.id
Ref: profiles.user_id > users.id
Ref: profiles.consent_by_user_id > users.id
Ref: video_interactions.profile_id > profiles.id
Ref: video_interactions.video_id > exercise_videos.id
Ref: ai_documents.video_id > exercise_videos.id
Ref: coach_run_proposal_items.coach_run_id > coach_runs.id
Ref: coach_run_proposal_items.video_id > exercise_videos.id
Ref: mission_participants.mission_id > missions.id
Ref: mission_participants.profile_id > profiles.id
Ref: mission_participants.confirmed_by_profile_id > profiles.id
Ref: coach_message_citations.coach_message_id > coach_messages.id
Ref: coach_message_citations.ai_document_id > ai_documents.id